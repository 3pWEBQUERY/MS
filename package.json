{
  "name": "ms-plattform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:predeploy": "npm run db:migrate && SEED_ONLY_IF_DEMO=1 npm run db:seed",
    "check:lines": "node scripts/check-lines.mjs",
    "test:db:prepare": "tsx scripts/test-db/prepare.ts ms_test",
    "test:db": "npm run test:db:prepare && vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "help:serve": "tsx src/static-help/server.ts",
    "drill:worker": "tsx scripts/drills/worker-restart.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
