# Railway Postgres (Referenzvariable: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres@localhost:5432/ms

# Öffentliche Basis-URL (für Links in E-Mails)
APP_URL=http://localhost:3000

# 32 Byte, base64 – z. B. `openssl rand -base64 32`. Pflicht in Produktion.
DATA_ENCRYPTION_KEY=
# Nur während einer Schlüsselrotation (Runbook R9): bisheriger Schlüssel, wird nur zum Lesen verwendet
# OLD_DATA_ENCRYPTION_KEY=
# Stabiler Schlüssel für Server Actions bei mehreren Instanzen (`openssl rand -base64 32`)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Railway Bucket (Referenzvariablen des Buckets)
BUCKET=
ENDPOINT=https://t3.storageapi.dev
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Transaktionsmails (vertraglich geprüfter Dienst, PRD 14)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MS Plattform <no-reply@example.ch>"

# Demo-Hinweis für Pilot-/Testumgebungen (Beispielinhalte noch nicht fachlich freigegeben)
DEMO_MODE=true

# Stündliche Sicherung (NFR07, nur Service «backup»; eigener Bucket, eigener Schlüssel)
# BACKUP_DATABASE_URL=
# BACKUP_ENCRYPTION_KEY=          # 32 Byte base64, zusätzlich offline verwahren
# BACKUP_BUCKET=
# BACKUP_ENDPOINT=
# BACKUP_REGION=
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_RETENTION_DAYS=35

# ACC04: Abgleich mit Pwned Passwords (k-Anonymität), erst nach Freigabe D04 einschalten
# PASSWORD_LEAK_CHECK=pwned
